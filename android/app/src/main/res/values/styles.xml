<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#050705</item>
        <item name="colorPrimaryDark">#050705</item>
        <item name="colorAccent">#39FF14</item>
        <item name="android:windowBackground">#050705</item>
        <item name="android:navigationBarColor">#050705</item>
        <item name="android:statusBarColor">#050705</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#050705</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#050705</item>
        <item name="android:windowBackground">#050705</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
